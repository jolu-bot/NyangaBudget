# .htaccess - Configuration Apache pour NyangaBudget sur Hostinger
# 
# Ce fichier configure Phusion Passenger pour exécuter l'application Flask
# et gère les redirections, la sécurité, et les fichiers statiques

# ==================== PHUSION PASSENGER CONFIGURATION ====================

# Activer Passenger pour cette application Python
PassengerEnabled On

# Répertoire racine de l'application
# ⚠️ IMPORTANT: Remplacer u123456789 par votre vrai ID utilisateur Hostinger
PassengerAppRoot /home/u123456789/public_html/nyangabudget

# Fichier de démarrage WSGI
PassengerStartupFile passenger_wsgi.py

# Chemin vers l'interpréteur Python du virtualenv
# ⚠️ IMPORTANT: Remplacer u123456789 par votre vrai ID utilisateur
PassengerPython /home/u123456789/nyangabudget_venv/bin/python3

# Environnement d'application (production)
PassengerAppEnv production

# Nombre minimum d'instances (ajuster selon les besoins)
PassengerMinInstances 1

# ==================== REDIRECTION HTTPS ====================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Forcer HTTPS (décommenter après activation SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Ne pas rediriger les fichiers qui existent réellement
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Rediriger tout le reste vers l'application Flask
    RewriteRule ^(.*)$ passenger_wsgi.py [QSA,L]
</IfModule>

# ==================== FICHIERS STATIQUES ====================

# Autoriser l'accès direct aux fichiers statiques (CSS, JS, Images)
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webmanifest)$">
    # Autoriser l'accès
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
    
    # Cache des fichiers statiques (30 jours)
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=2592000, immutable"
    </IfModule>
    
    # Compression gzip
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/css application/javascript image/svg+xml
    </IfModule>
</FilesMatch>

# ==================== SÉCURITÉ ====================

# Protéger les fichiers sensibles
<FilesMatch "\.(db|sqlite|sqlite3|env|log|ini|conf|bak|backup)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protéger les fichiers Python (sauf passenger_wsgi.py)
<FilesMatch "\.py$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Exception pour passenger_wsgi.py (doit être accessible)
<Files "passenger_wsgi.py">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

# Protéger le dossier uploads (accès uniquement via Flask)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/uploads/vault/ [OR]
    RewriteCond %{REQUEST_URI} ^/uploads/heritage/ [OR]
    RewriteCond %{REQUEST_URI} ^/uploads/receipts/
    RewriteRule .* - [F,L]
</IfModule>

# Désactiver le listing de répertoires
Options -Indexes

# ==================== HEADERS DE SÉCURITÉ ====================

<IfModule mod_headers.c>
    # Prévenir les attaques XSS
    Header set X-XSS-Protection "1; mode=block"
    
    # Prévenir le MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Protection contre le clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Politique de référent
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Content Security Policy (ajuster selon vos besoins)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' cdn.jsdelivr.net cdn.plot.ly; style-src 'self' 'unsafe-inline' cdn.jsdelivr.net fonts.googleapis.com; font-src 'self' cdn.jsdelivr.net fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'"
    
    # Forcer HTTPS (Strict Transport Security) - Activer après SSL
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ==================== GESTION DES ERREURS ====================

# Pages d'erreur personnalisées (optionnel)
# ErrorDocument 404 /errors/404.html
# ErrorDocument 500 /errors/500.html

# ==================== COMPRESSION ====================

<IfModule mod_deflate.c>
    # Compresser HTML, CSS, JS, XML, JSON
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==================== LIMITES DE TÉLÉCHARGEMENT ====================

# Augmenter la taille max d'upload (16 MB)
# Note: Vérifier aussi les paramètres PHP dans hPanel si nécessaire
<IfModule mod_php7.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 16M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

# ==================== OPTIMISATION ====================

# Activer Keep-Alive
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# Désactiver ETags (optionnel pour performances)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None
