# ========================================
# NYANGABUDGET 2.0 - VARIABLES D'ENVIRONNEMENT
# ========================================
# 
# Ce fichier est un template pour vos variables d'environnement.
# Pour le développement local:
#   1. Copiez ce fichier en .env (ne jamais committer .env!)
#   2. Remplissez les valeurs
#   3. Installez python-dotenv: pip install python-dotenv
#
# Pour la production (Render):
#   Les variables sont configurées automatiquement via render.yaml
# ========================================

# SECRET KEY - Clé secrète Flask (minimum 32 caractères)
# En production: générée automatiquement par Render
SECRET_KEY=nyanga-2.0-ultra-secure-key-joyed-cameroon-2025

# MASTER ENCRYPTION KEY - Clé de cryptage pour le coffre-fort (32 caractères)
# ⚠️ IMPORTANT: Ne jamais changer cette clé après avoir crypté des fichiers!
# En production: générée automatiquement par Render
MASTER_ENCRYPTION_KEY=YourSecureMasterKey32BytesHere!!

# DATABASE_URL - URL de la base de données
# Développement local: laisser vide (SQLite sera utilisé automatiquement)
# Production: fournie automatiquement par Render PostgreSQL
# DATABASE_URL=

# FLASK_ENV - Environnement Flask
# Valeurs possibles: development, production
FLASK_ENV=development

# FLASK_DEBUG - Mode debug (uniquement en développement!)
# Valeurs possibles: True, False
FLASK_DEBUG=True

# ========================================
# NOTES IMPORTANTES
# ========================================
# 
# 1. Ne JAMAIS committer le fichier .env sur Git!
#    Ajoutez .env dans votre .gitignore
#
# 2. En production sur Render:
#    - SECRET_KEY est générée automatiquement
#    - MASTER_ENCRYPTION_KEY est générée automatiquement
#    - DATABASE_URL est fournie par PostgreSQL
#
# 3. Pour utiliser ces variables en local:
#    - Installez: pip install python-dotenv
#    - Ajoutez dans app.py au début:
#      from dotenv import load_dotenv
#      load_dotenv()
#
# ========================================
