# ==========================================
# NYANGABUDGET 2.0 - VARIABLES D'ENVIRONNEMENT
# ==========================================
# 
# TEMPLATE pour configuration en production (Hostinger) et développement local
# 
# INSTRUCTIONS:
# 1. Copier ce fichier vers .env
# 2. Remplacer toutes les valeurs par vos vraies credentials
# 3. Ne JAMAIS commiter le fichier .env sur Git
# 4. Installer: pip install python-dotenv
#
# ==========================================

# ==================== ENVIRONNEMENT ====================

# Environnement Flask (production ou development)
FLASK_ENV=production

# Mode debug (False en production)
DEBUG=False
FLASK_DEBUG=False

# ==================== BASE DE DONNÉES MYSQL (HOSTINGER) ====================

# Hôte de la base de données
# Pour Hostinger: généralement 'localhost'
DB_HOST=localhost

# Nom d'utilisateur MySQL (Format Hostinger: u123456789_votreuser)
# ⚠️ IMPORTANT: Remplacer par votre vrai utilisateur MySQL depuis hPanel
DB_USER=u123456789_nyanga

# Mot de passe MySQL
# ⚠️ IMPORTANT: Utiliser le mot de passe créé dans hPanel > MySQL Databases
DB_PASSWORD=VotreMotDePasseMySQL_Secure_32Chars

# Nom de la base de données (Format Hostinger: u123456789_votrebase)
# ⚠️ IMPORTANT: Remplacer par votre vraie base de données depuis hPanel
DB_NAME=u123456789_nyangabudget

# Port MySQL (généralement 3306)
DB_PORT=3306

# URL complète (optionnel - sera construite automatiquement si non fournie)
# FORMAT: mysql+pymysql://utilisateur:motdepasse@hote:port/base
# DATABASE_URL=mysql+pymysql://u123456789_nyanga:password@localhost:3306/u123456789_nyangabudget

# ==================== ALTERNATIVE: POSTGRESQL (RENDER/HEROKU) ====================

# Si vous utilisez PostgreSQL au lieu de MySQL (Render, Heroku, etc.)
# Décommenter et remplir cette ligne, commenter la section MySQL ci-dessus
# DATABASE_URL=postgresql://user:password@host:5432/database

# ==================== CLÉS DE SÉCURITÉ ====================

# Clé secrète Flask (32+ caractères aléatoires)
# Générer avec: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ CRITIQUE: Changer cette valeur en production!
SECRET_KEY=CHANGE-THIS-nyanga-secret-key-32-characters-minimum-here

# Clé maître de cryptage pour coffre-fort AES-256 (32+ caractères)
# Générer avec: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ CRITIQUE: Ne JAMAIS changer après avoir crypté des fichiers!
MASTER_ENCRYPTION_KEY=CHANGE-THIS-encryption-key-32-characters-minimum-here

# ==================== SERVEUR WEB ====================

# Port du serveur (5000 par défaut, géré par Hostinger/Passenger en prod)
PORT=5000

# Hôte (0.0.0.0 pour écouter toutes les interfaces)
HOST=0.0.0.0

# ==================== CACHE REDIS (OPTIONNEL) ====================

# URL Redis pour le cache Flask (si disponible sur Hostinger)
# Contacter le support Hostinger pour activer Redis
# Format: redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0

# ==================== EMAILS (OPTIONNEL) ====================

# Configuration SMTP pour envoi d'emails
# Utile pour: notifications, récupération de mot de passe, etc.

# Serveur SMTP Hostinger
# MAIL_SERVER=smtp.hostinger.com

# Port SMTP (587 pour TLS, 465 pour SSL)
# MAIL_PORT=587

# Utiliser TLS
# MAIL_USE_TLS=True

# Utiliser SSL (si port 465)
# MAIL_USE_SSL=False

# Identifiant email
# MAIL_USERNAME=votre-email@votredomaine.com

# Mot de passe email
# MAIL_PASSWORD=votre-mot-de-passe-email

# Expéditeur par défaut
# MAIL_DEFAULT_SENDER=noreply@votredomaine.com

# ==================== LOGS ====================

# Niveau de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Chemin vers le fichier de logs (optionnel)
# LOG_FILE=/home/u123456789/public_html/nyangabudget/logs/nyanga.log

# ==================== LIMITES ====================

# Taille maximale des fichiers uploadés (en octets)
# 16 MB = 16777216 octets
MAX_CONTENT_LENGTH=16777216

# Nombre maximum de requêtes par jour (Rate Limiting)
RATE_LIMIT_DAY=200

# Nombre maximum de requêtes par heure
RATE_LIMIT_HOUR=50

# ==================== APPLICATION ====================

# Domaine de l'application (pour génération de liens absolus)
# ⚠️ IMPORTANT: Remplacer par votre vrai domaine
APP_DOMAIN=https://votredomaine.com

# Nom de l'application (optionnel)
APP_NAME=NyangaBudget

# ==================== MONITORING (OPTIONNEL) ====================

# Clé API Sentry pour monitoring des erreurs
# Inscription gratuite sur: https://sentry.io
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ==================== BACKUP (OPTIONNEL) ====================

# Répertoire de backup
# BACKUP_DIR=/home/u123456789/backups

# Nombre de jours de conservation des backups
# BACKUP_RETENTION_DAYS=7

# ==================== NOTES IMPORTANTES ====================
#
# 🔐 SÉCURITÉ:
# - Ne JAMAIS commiter le fichier .env sur Git
# - Ajouter .env dans .gitignore
# - Utiliser des mots de passe forts (32+ caractères aléatoires)
# - Changer toutes les clés par défaut en production
# - Ne jamais partager vos credentials
#
# 📝 GÉNÉRATION DE CLÉS SÉCURISÉES:
# 
# Dans PowerShell ou Terminal:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Résultat (exemple):
#   K7JxXvY3Rz9Tm4Wp8Qs2Nf6Hd1Lc5Bv0Xa
#
# Copier ce résultat dans SECRET_KEY et MASTER_ENCRYPTION_KEY
#
# 🗄️ BASE DE DONNÉES:
#
# Pour SQLite (développement local):
#   - Ne pas définir DB_HOST, DB_USER, DB_PASSWORD, DB_NAME
#   - L'application utilisera automatiquement data/nyanga_v2.db
#
# Pour MySQL (Hostinger):
#   - Définir DB_HOST, DB_USER, DB_PASSWORD, DB_NAME
#   - L'application détectera automatiquement MySQL
#
# Pour PostgreSQL (Render, Heroku):
#   - Définir DATABASE_URL
#   - Format: postgresql://user:pass@host:5432/db
#
# 🔗 DOCUMENTATION:
# Voir DEPLOIEMENT_HOSTINGER.md pour guide complet étape par étape
#
# ==========================================
#    - Ajoutez dans app.py au début:
#      from dotenv import load_dotenv
#      load_dotenv()
#
# ========================================
