# ================================================
# CONFIGURATION ENVIRONNEMENT - NYANGABUDGET 2.0
# ================================================

# ⚠️ IMPORTANT : Ne jamais commit le fichier .env réel !
# Ce fichier est un template. Copier en .env et remplir les valeurs.

# ====================
# SÉCURITÉ
# ====================

# SECRET_KEY : Clé secrète Flask (OBLIGATOIRE en production)
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=votre-cle-secrete-super-longue-et-aleatoire

# ====================
# BASE DE DONNÉES
# ====================

# SQLite (développement local)
DATABASE_URL=sqlite:///data/nyanga.db

# MySQL (PythonAnywhere production)
# DATABASE_URL=mysql+pymysql://username:password@username.mysql.pythonanywhere-services.com/username$nyangabudget

# PostgreSQL (alternative)
# DATABASE_URL=postgresql://username:password@localhost:5432/nyangabudget

# ====================
# CONFIGURATION FLASK
# ====================

# Environnement : development | production | testing
FLASK_ENV=production

# Mode debug (TOUJOURS False en production !)
FLASK_DEBUG=0

# Hôte et port (développement local uniquement)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ====================
# UPLOADS ET FICHIERS
# ====================

# Taille maximale upload (en octets, 16MB par défaut)
MAX_CONTENT_LENGTH=16777216

# Chemin dossier uploads
UPLOAD_FOLDER=uploads

# Extensions autorisées
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif

# ====================
# OCR ET IA
# ====================

# OpenAI API (pour scan intelligent des reçus)
OPENAI_API_KEY=sk-votre-cle-openai-ici

# Tesseract OCR (chemin si non standard)
# TESSERACT_CMD=/usr/bin/tesseract

# ====================
# EMAIL (OPTIONNEL)
# ====================

# Configuration SMTP pour notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-application
MAIL_DEFAULT_SENDER=noreply@nyangabudget.com

# ====================
# SÉCURITÉ AVANCÉE
# ====================

# Rate limiting (requêtes par minute)
RATE_LIMIT_PER_MINUTE=60

# Session lifetime (en minutes)
SESSION_LIFETIME=60

# CSRF protection
WTF_CSRF_ENABLED=1
WTF_CSRF_TIME_LIMIT=3600

# ====================
# LOGS
# ====================

# Niveau de log : DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Fichier de log
LOG_FILE=logs/app.log

# ====================
# CACHE (OPTIONNEL)
# ====================

# Type de cache : null | simple | redis | memcached
CACHE_TYPE=simple

# Redis (si utilisé)
# CACHE_REDIS_URL=redis://localhost:6379/0

# Durée de cache (en secondes)
CACHE_DEFAULT_TIMEOUT=300

# ====================
# DÉVELOPPEMENT
# ====================

# Activer mode test
TESTING=0

# Désactiver vérifications strictes (dev uniquement)
SQLALCHEMY_TRACK_MODIFICATIONS=0

# ====================
# PRODUCTION
# ====================

# URL production
PRODUCTION_URL=https://votre-username.pythonanywhere.com

# Forcer HTTPS
PREFERRED_URL_SCHEME=https

# ====================
# VARIABLES OPTIONNELLES
# ====================

# Stripe (si paiements futurs)
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# Sentry (monitoring erreurs)
# SENTRY_DSN=https://...@sentry.io/...

# Google Analytics
# GA_TRACKING_ID=UA-...

# ====================
# NOTES
# ====================

# 1. Copier ce fichier en .env : cp .env.example .env
# 2. Remplir toutes les valeurs OBLIGATOIRES
# 3. Ne jamais commit le fichier .env réel
# 4. Ajouter .env au .gitignore
# 5. En production, charger avec python-dotenv
